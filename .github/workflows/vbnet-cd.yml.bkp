name: VB.NET CD to Azure VM

on:
  workflow_run:
    workflows: ["VB.NET CI"]
    types: [completed]
    branches: [main, master]
  workflow_dispatch:
    inputs:
      run-id:
        description: 'CI workflow run ID to deploy from (leave empty for latest successful)'
        required: false
        type: string

jobs:
  deploy-dev:
    name: Deploy to Dev
    runs-on: [self-hosted, windows, vbnet]
    if: >
      (github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'success') ||
      (github.event_name == 'workflow_dispatch')
    environment: dev

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Load environment configuration
        id: config
        uses: ./.github/actions/load-config
        with:
          environment: dev
          app-type: vbnet

      - name: Azure Login
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Download deployment package from CI workflow
        id: download
        uses: ./.github/actions/download-workflow-artifact
        with:
          workflow: vbnet-ci.yml
          run-id: ${{ github.event.inputs.run-id || github.event.workflow_run.id }}
          artifact-name: deployment-package-${{ github.event.workflow_run.head_sha || github.sha }}
          path: ./deployment-artifacts
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Find deployment package
        id: find-package
        if: steps.download.outputs.artifact-found == 'true'
        shell: pwsh
        run: |
          $package = Get-ChildItem -Path "./deployment-artifacts" -Filter "*.zip" -File -Recurse -ErrorAction SilentlyContinue |
                     Select-Object -First 1

          if ($package) {
            Write-Host "Package found: $($package.FullName)"
            Write-Host "Package size: $([math]::Round($package.Length / 1MB, 2)) MB"
            echo "package-path=$($package.FullName)" >> $env:GITHUB_OUTPUT
            echo "package-found=true" >> $env:GITHUB_OUTPUT
          } else {
            Write-Host "No deployment package found in artifacts!"
            echo "package-found=false" >> $env:GITHUB_OUTPUT
          }

      - name: Deploy to IIS
        id: deploy
        if: steps.find-package.outputs.package-found == 'true'
        uses: ./.github/actions/iis-deploy
        with:
          vm-name: ${{ steps.config.outputs.vm-name }}
          resource-group: ${{ steps.config.outputs.resource-group }}
          storage-account: ${{ steps.config.outputs.storage-account }}
          storage-container: ${{ steps.config.outputs.storage-container }}
          package-path: ${{ steps.find-package.outputs.package-path }}
          iis-site-name: ${{ steps.config.outputs.iis-site }}
          iis-app-name: ${{ steps.config.outputs.iis-app-name }}
          iis-app-pool: ${{ steps.config.outputs.iis-app-pool }}
          environment: dev

      - name: Deployment summary
        if: always()
        shell: pwsh
        env:
          VM_NAME: ${{ steps.config.outputs.vm-name }}
          RESOURCE_GROUP: ${{ steps.config.outputs.resource-group }}
          IIS_APP_NAME: ${{ steps.config.outputs.iis-app-name }}
          APP_URL: ${{ steps.deploy.outputs.app-url }}
          DEPLOY_STATUS: ${{ steps.deploy.outputs.deployment-status }}
          ARTIFACT_FOUND: ${{ steps.download.outputs.artifact-found }}
          ARTIFACT_RUN_ID: ${{ steps.download.outputs.run-id }}
        run: |
          "### VB.NET Deployment Summary" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
          "" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
          "**VM:** ``$($env:VM_NAME)``" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
          "**Resource Group:** ``$($env:RESOURCE_GROUP)``" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
          "**Application:** ``$($env:IIS_APP_NAME)``" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
          "**Source Run:** ``$($env:ARTIFACT_RUN_ID)``" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
          "" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append

          if ($env:ARTIFACT_FOUND -eq "true") {
            "**Deployment Status:** $($env:DEPLOY_STATUS)" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
            "**Application URL:** $($env:APP_URL)" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
          } else {
            "**Status:** No deployment package found" | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append
          }
